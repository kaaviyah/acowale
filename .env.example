# ─── Copy to .env.local for local development ───────────────────────────────
#   cp .env.example .env.local
# Every value below is safe for local development and unsafe for production.
# `src/server/lib/env.ts` refuses to boot in production if these placeholders
# are still in place.

# ─── Database ───────────────────────────────────────────────────────────────
# Two supported forms (the driver is picked from the scheme — see src/server/db/client.ts):
#   file:./.data/dev      → PGlite, real Postgres running in-process. No account, no Docker.
#   postgres://…          → Neon (or any Postgres). Use Neon's POOLED connection string here.
DATABASE_URL="file:./.data/dev"

# Neon's pooled endpoint multiplexes connections, which is right for the app and
# wrong for migrations (they need one session for advisory locks). Point this at
# Neon's direct/unpooled string in production; leave unset locally.
# DATABASE_URL_UNPOOLED="postgres://…"

# ─── Auth ───────────────────────────────────────────────────────────────────
# Signs the admin session cookie. Rotating it logs everyone out.
#   openssl rand -base64 48
SESSION_SECRET="dev-session-secret-at-least-32-characters-long"
SESSION_TTL_HOURS="8"

# Generate the hash with:  pnpm hash-password 'your-password'
# The plaintext password is never stored anywhere — only this scrypt hash.
# The dev credentials below are  admin@acowale.test  /  acowale-dev
ADMIN_EMAIL="admin@acowale.test"
ADMIN_PASSWORD_HASH="scrypt:16384:8:1:bA21OTEuavykYfLjHHukJQ==:3UxUvpCqjyQ/onYl9NGVZsItDhDEiLAgX+1F6eWrCcY="

# ─── Rate limiting ──────────────────────────────────────────────────────────
# Client IPs are stored only as sha256(ip + salt), so the rate-limit table never
# holds a raw IP. The salt makes those hashes non-enumerable.
RATE_LIMIT_SALT="dev-rate-limit-salt-change-me"

# ─── Observability ──────────────────────────────────────────────────────────
LOG_LEVEL="debug"
# Surfaced by /api/health. On Vercel this falls back to VERCEL_GIT_COMMIT_SHA.
# APP_VERSION="local"
